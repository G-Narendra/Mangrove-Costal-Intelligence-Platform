# Coastal Sentinel Backend API - Environment Configuration Template
# Copy this file to .env and provide your credentials.

# NASA Earthdata Login (for GEDI & satellite download)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Google Cloud / Firebase Service Account (path to json or json string)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
GEE_PROJECT_ID=your_gee_project_id

# Target Ingestion Window
TARGET_START_MONTH=2026-04

# External Weather & Context APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
NEWS_API_KEY=your_news_api_key

# Optional: Port configuration
PORT=8000
