# Coastal Sentinel Web Frontend - Environment Configuration Template
# Copy this file to .env.local and add your actual API keys.

# Google Gemini / GenAI API Key for XAI Landscape Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Next.js Public Backend URL (live Render deployment or localhost:8000)
NEXT_PUBLIC_BACKEND_URL=https://coastal-sentinel-api-lbza.onrender.com
